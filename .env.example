# Resend API key. Create one at https://resend.com/api-keys
# Server-only: do NOT prefix with NEXT_PUBLIC_, or it ships to the browser.
RESEND_API_KEY=

# Inbox(es) that receive website enquiries. Comma-separate for several:
#   ENQUIRY_TO_EMAIL=one@example.com,two@example.com
# Until sigmen.com DNS is verified in Resend, this must be the email the
# Resend account was created with. Resend's free tier will not deliver to
# any other address without a verified domain.
ENQUIRY_TO_EMAIL=

# Address enquiries are sent from. Leave unset to use Resend's sandbox
# sender. Once sigmen.com is verified, set something like
# enquiries@sigmen.com so replies go to a real mailbox.
# ENQUIRY_FROM_EMAIL=
